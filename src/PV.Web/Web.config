<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <connectionStrings>
    <add name="PVRef" connectionString="Data Source=localhost,1433;Initial Catalog=PortfolioViewer;User ID=pv_app;Password=pvapp2013;" />
  </connectionStrings>
  <appSettings>
    <add key="ArchiveRoot" value="..\..\archive" />
    <add key="SupportExt" value="4417" />
  </appSettings>
  <log4net>
    <appender name="File" type="log4net.Appender.RollingFileAppender">
      <file value="logs\pv.log" />
      <appendToFile value="true" />
      <rollingStyle value="Composite" />
      <datePattern value=".yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="2MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="File" />
    </root>
  </log4net>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="On" defaultRedirect="Error.aspx" />
    <sessionState mode="InProc" />
  </system.web>
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
